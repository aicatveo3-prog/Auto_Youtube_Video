# ── YouTube 원본 자막 페이로드 ───────────────────────────────
# 사이트는 이 파일을 쓰지 않습니다. 105MB 넘게 차지하고, 필요하면
# yt-dlp 로 언제든 다시 받을 수 있으므로 저장소에서 제외합니다.
transcripts/*/raw.json3

# ── 로그 / 상태 파일 ─────────────────────────────────────────
transcripts/_fetch.log
*.log

# ── 파이썬 ───────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── 비밀값 (혹시라도 생길 경우 대비) ─────────────────────────
.env
.env.*
*.key
secrets.json

# ── 검증용 임시 파일 (이름이 _ 로 시작) ──────────────────────
_*.py
_*.txt
_*.js

# ── OS / 에디터 잡동사니 ─────────────────────────────────────
Thumbs.db
.DS_Store
desktop.ini
